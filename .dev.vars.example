# LOCAL Pages Functions only; copy to ignored .dev.vars. Never use VITE_ for secrets.
# NEW dynamic Supplier API settings: backend-only, never VITE_ variables.
# 32 random bytes, base64 encoded; generate locally using: openssl rand -base64 32
SUPPLIER_ENCRYPTION_KEY=
# Legacy ShopViaClone22 connector only. YoungPG keys are entered through /admin/settings/supplier-api.
SUPPLIER_API_KEY=
# Fill only after verifying official response examples and resale authorization.
SUPPLIER_SCHEMA_VERIFIED=
SUPPLIER_COST_CURRENCY=
# JSON product-ID -> verified license/resale evidence reference; empty blocks imports.
SUPPLIER_AUTHORIZED_PRODUCTS={}

# Scheduled read-only sync; disabled until configured and preview-tested.
SUPPLIER_SYNC_ENABLED=false
SCHEDULER_SHARED_SECRET=

# Email preview/test sender ONLY. Never use VITE_ variables for these values.
# Verify logspoll.com with Resend before enabling. Approve a dedicated test inbox.
RESEND_API_KEY=
EMAIL_TEST_ENABLED=false
EMAIL_FROM=no-reply@logspoll.com
EMAIL_TEST_TO=
