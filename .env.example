# Copy to .env.local and fill from your EXISTING Supabase project's API settings.
# A legacy anon JWT is also accepted. Never use service_role or sb_secret_* keys.
# Every VITE_* value is public browser configuration. Restart Vite after editing.
# Production keeps its verified legacy provider until data cutover is approved.
# Use cloudflare for the D1-enabled mobile-preview deployment only.
VITE_AUTH_PROVIDER=supabase
