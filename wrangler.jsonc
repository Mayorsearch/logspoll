{
	"name": "logspoll",
	"pages_build_output_dir": "./dist",
	"compatibility_date": "2026-10-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"BACHS_SANDBOX_ENABLED": "false",
		"VITE_BACHS_SANDBOX_TEST_UI": "false",
		"SUPPLIER_SYNC_ENABLED": "false",
		"ENVIRONMENT": "production",
    "PRODUCTION_CUTOVER_ENABLED": "true",
    "CATALOG_SYNC_ENABLED": "true",
		"AUTH_ENABLED": "true",
		"AUTH_ORIGIN": "https://logspoll.com",
		"BACHS_LIVE_CHECKOUT_ENABLED": "true",
		"BACHS_LIVE_VERIFIED": "true",
		"BACHS_FULFILLMENT_VERIFIED": "true",
		"AUTO_FULFILLMENT_ENABLED": "true",
		"WALLET_LIVE_FUNDING_ENABLED": "false"
	},
	"env": {
		"preview": {
			"vars": {
				"SUPPLIER_SYNC_ENABLED": "false",
				"BACHS_SANDBOX_ENABLED": "false",
				"VITE_BACHS_SANDBOX_TEST_UI": "false",
				"ENVIRONMENT": "staging",
				"AUTH_ENABLED": "true",
				"CATALOG_SYNC_ENABLED": "false",
				"AUTH_ORIGIN": "https://mobile-preview.logspoll.pages.dev",
				"APP_ORIGIN": "https://mobile-preview.logspoll.pages.dev"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "logspoll-d1-staging-20261012",
					"database_id": "d337160c-36e3-4a1d-9908-76a6873b4188",
					"migrations_dir": "workers/api/migrations"
				}
			]
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "logspoll-d1-production",
			"database_id": "f0be42ec-fbae-4134-9eef-19ef26098e33",
      "migrations_dir": "workers/api/migrations"
		}
	]
}
